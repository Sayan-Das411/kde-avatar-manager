# This file is a reference copy only — the actual file is generated by `kdam enable`
# via _write_systemd_files() in kdam/_cli_shared.py.  Keep this in sync with that function.
[Unit]
Description=KDE Avatar Auto-Rotator
# Wait for plasmashell's D-Bus name to be acquired before firing.
# plasma-plasmashell.service is Type=dbus, so systemd marks it
# 'started' only once it owns its bus name — which is exactly when
# the notification daemon is live.  This replaces the old dumb
# 'sleep 5' that caused visible latency on fresh logins.
After=plasma-plasmashell.service
Wants=plasma-plasmashell.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/kdam next --quiet
