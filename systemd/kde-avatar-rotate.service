# This file is a reference copy only — the actual file is generated by `kdam enable`
# via _write_systemd_files() in kdam/_cli_shared.py.  Keep this in sync with that function.
[Unit]
Description=KDE Avatar Auto-Rotator
# Wait for the full graphical session so that the notification daemon
# (knotificationd / plasmashell) is running before we attempt to send
# desktop notifications.  Without this, notify-send fires into the void
# when the service is triggered on login after a missed midnight timer.
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=oneshot
# Brief delay lets the notification daemon fully settle on fresh logins.
ExecStartPre=/bin/sleep 5
ExecStart=%h/.local/bin/kdam next --quiet
